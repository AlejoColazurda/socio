# --- Meta Model API (https://dev.meta.ai) ---
MODEL_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
# Comprobá el ID vigente con GET /api/health (lista /v1/models).
SOCIO_PLANNER_MODEL=muse-spark-1.3
SOCIO_VERIFIER_MODEL=muse-spark-1.3
SOCIO_TRANSCRIBE_MODEL=muse-voice-transcribe-1.0
SOCIO_SAM_MODEL=sam-3.1

# 1 = usa respuestas simuladas de Meta (sirve para desarrollar y testear sin clave).
SOCIO_MOCK=0

# --- Estado propio de Socio (acciones, aprobaciones, auditoría) ---
# file = .data/socio.json (local) · memory = solo en RAM (tests)
SOCIO_STORE=file

# --- Sistema conectado ---
# demo = ERP en memoria con catálogo de kiosco · mk247 = Supabase del Maxikiosco 24/7 · rest = cualquier API HTTP
SOCIO_CONNECTOR=demo

# mk247 (solo lectura salvo que MK247_ALLOW_WRITES=1)
MK247_SUPABASE_URL=
MK247_SUPABASE_KEY=
MK247_ALLOW_WRITES=0

# rest: tu ERP/CRM/SaaS expone estos endpoints (ver connectors/rest.ts)
REST_BASE_URL=
REST_TOKEN=

# --- WhatsApp Cloud API ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Números (formato 549...) autorizados a operar el negocio
SOCIO_OWNER_NUMBERS=
